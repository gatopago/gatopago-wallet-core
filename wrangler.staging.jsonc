{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gatopago-wallet-core-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "CREATION_QUEUE_NAME": "gatopago-wallet-core-staging-jobs",
    "GATOPAGO_ENVIRONMENT": "staging",
    "GATOPAGO_WEB_ORIGIN": "https://staging.gatopago.com",
    "GATOPAGO_API_ORIGIN": "https://api.staging.gatopago.com",
    "GATOPAGO_BUSINESS_ORIGIN": "https://business.staging.gatopago.com",
    "GATOPAGO_WALLET_NETWORKS": "eip155:421614",
    "FIREBASE_PROJECT_ID": "proyecto-prueba-push-firebase",
    "AUTH_IP_REQUESTS_PER_HOUR": "120",
    "AUTH_GLOBAL_REQUESTS_PER_HOUR": "2000",
    "PUBLIC_LOOKUP_IP_REQUESTS_PER_HOUR": "120",
    "PUBLIC_LOOKUP_GLOBAL_REQUESTS_PER_HOUR": "2000"
  },
  "d1_databases": [
    {
      "binding": "WALLET_DB",
      "database_name": "gatopago-wallet-core-staging",
      "database_id": "f9aa958c-2c16-4fed-b3e4-a76d9160eb33",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "CREATION_JOBS",
        "queue": "gatopago-wallet-core-staging-jobs",
        "remote": false
      }
    ],
    "consumers": [
      {
        "queue": "gatopago-wallet-core-staging-jobs",
        "max_batch_size": 2,
        "max_batch_timeout": 1,
        "max_concurrency": 2,
        "max_retries": 3,
        "retry_delay": 60,
        "dead_letter_queue": "gatopago-wallet-core-staging-jobs-dlq"
      }
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "account_id": "c26e82cd341803c9136e19e668da67c6",
  "routes": [
    {
      "pattern": "api.staging.gatopago.com",
      "custom_domain": true
    }
  ]
}
