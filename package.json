{
  "name": "gatopago-wallet-core",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "db:migrate": "wrangler d1 migrations apply WALLET_DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply WALLET_DB --local",
    "db:list": "wrangler d1 migrations list WALLET_DB --remote",
    "cf-typegen": "wrangler types --env-interface WalletCoreV3Bindings --strict-vars false",
    "typecheck": "tsc --noEmit && tsc --noEmit --project test-worker/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "build": "wrangler deploy --dry-run --outdir .wrangler/build"
  },
  "dependencies": {
    "@gatopago/environment": "file:vendor/gatopago-environment-3.2.1.tgz",
    "@gatopago/shared": "file:vendor/gatopago-shared-3.2.1.tgz",
    "@simplewebauthn/server": "13.3.2",
    "jose": "^6.2.10",
    "viem": "2.55.19"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@eslint/js": "^10.0.1",
    "@gatopago/contract-artifacts": "file:vendor/gatopago-contract-artifacts-3.1.0.tgz",
    "@gatopago/test-fixtures": "file:vendor/gatopago-test-fixtures-3.2.1.tgz",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "wrangler": "4.136.0"
  },
  "private": true,
  "packageManager": "pnpm@11.23.0"
}
