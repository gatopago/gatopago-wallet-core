{
  "name": "gatopago-wallet-core",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "db:migrate": "wrangler d1 migrations apply WALLET_DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply WALLET_DB --local",
    "db:list": "wrangler d1 migrations list WALLET_DB --remote",
    "cf-typegen": "wrangler types --strict-vars false --env-file .dev.vars.example",
    "typecheck": "tsc --noEmit && tsc --noEmit --project test/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir .wrangler/build"
  },
  "dependencies": {
    "@gatopago/shared": "file:vendor/gatopago-shared-6.10.0.tgz",
    "@stellar/stellar-sdk": "17.2.0",
    "jose": "^6.2.10",
    "viem": "2.55.19"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "wrangler": "4.136.0"
  },
  "private": true,
  "packageManager": "pnpm@11.23.0"
}
