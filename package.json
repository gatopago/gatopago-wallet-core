{
  "name": "gatopago-wallet-core",
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "wrangler dev --env-file .env",
    "cf-typegen": "wrangler types --env-interface WalletCoreV3Bindings --strict-vars false --env-file .dev.vars.example",
    "cf-typegen:check": "pnpm cf-typegen --check",
    "typecheck": "tsc --noEmit && tsc --noEmit --project test-worker/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "check:query-plans": "node scripts/check-query-plans.mjs",
    "check:console": "node scripts/check-console.mjs",
    "verify": "pnpm cf-typegen:check && pnpm typecheck && pnpm lint && pnpm check:query-plans && pnpm check:console && pnpm test && pnpm build",
    "test": "pnpm test:unit && pnpm test:worker-runtime",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:worker-runtime": "vitest run --config vitest.worker.config.ts",
    "build": "node scripts/check-vendor.mjs && wrangler deploy --dry-run --env-file .dev.vars.example --outdir .wrangler/build",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry-run": "node scripts/deploy.mjs --dry-run"
  },
  "dependencies": {
    "@gatopago/environment": "file:vendor/gatopago-environment-3.1.0.tgz",
    "@gatopago/shared": "file:vendor/gatopago-shared-3.1.0.tgz",
    "@simplewebauthn/server": "13.3.2",
    "jose": "^6.2.10",
    "viem": "^2.55.19"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@eslint/js": "^10.0.1",
    "@gatopago/test-fixtures": "file:vendor/gatopago-test-fixtures-3.1.0.tgz",
    "@gatopago/contract-artifacts": "file:vendor/gatopago-contract-artifacts-3.1.0.tgz",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "wrangler": "4.136.0"
  },
  "private": true,
  "packageManager": "pnpm@11.23.0"
}
